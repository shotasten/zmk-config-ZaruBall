//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define ADJUST   4
#define SCROLL   2

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         &zip_temp_layer MOUSE 350
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 30
                            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LEFT_CONTROL LEFT_CONTROL>, <&mo 2>;

            label = "hidari sita";
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "MKP_EXIT_AML";
        };

        pw: pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp S &kp H &kp I &kp O &kp R &kp I &kp AT &kp N0 &kp N6 &kp N0 &kp N4 &kp ENTER>;
            label = "PW";
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESCAPE  &kp N1      &kp N2  &kp N3        &kp N4        &kp N5                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                       &kp NUMBER_6     &kp N7  &kp N8     &kp N9   &kp N0     &kp DELETE
&kp TAB     &kp Q       &kp W   &kp E         &kp R         &kp T                          &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                     &kp Y            &kp U   &kp I      &kp O    &kp P      &kp NON_US_BACKSLASH
&kp CAPS    &kp A       &kp S   &kp D         &kp F         &kp G        &lt 4 HOME        &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp PAGE_UP      &kp H            &kp J   &kp K      &kp L    &kp ENTER  &kp BACKSPACE
&kp LSHFT   &kp Z       &kp X   &kp C         &kp V         &kp B        &kp GRAVE         &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp PAGE_DOWN    &kp N            &kp M   &kp COMMA  &kp DOT  &kp FSLH   &kp RIGHT_SHIFT
&td2        &kp C_MUTE          &kp LEFT_WIN  &kp LEFT_ALT  &lt 2 SPACE  &kp LEFT_SHIFT                                                            &lt 2 RIGHT_ALT  &lt 3 BACKSPACE                                         &lt SCROLL RIGHT_CONTROL
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&to_layer_0 ESC     &to_layer_0 N1  &to_layer_0 N2  &to_layer_0 N3  &to_layer_0 N4  &to_layer_0 N5                     &trans  &trans  &trans  &trans                     &to_layer_0 N6  &to_layer_0 N7  &to_layer_0 N8  &to_layer_0 N9      &to_layer_0 N0     &to_layer_0 DEL
&to_layer_0 TAB     &to_layer_0 Q   &to_layer_0 W   &to_layer_0 E   &to_layer_0 R   &to_layer_0 T                      &trans  &trans  &trans  &trans                     &to_layer_0 Y   &to_layer_0 U   &to_layer_0 I   &to_layer_0 P       &to_layer_0 O      &to_layer_0 NON_US_BACKSLASH
&trans              &to_layer_0 A   &trans          &trans          &trans          &trans          &msc SCRL_LEFT     &trans  &trans  &trans  &trans    &msc SCRL_LEFT   &msc SCRL_UP    &mkp LCLK       &mo 2           &mkp RCLK           &mkp MCLK          &to_layer_0 BACKSPACE
&to_layer_0 LSHIFT  &to_layer_0 Z   &to_layer_0 X   &trans          &trans          &trans          &msc SCRL_RIGHT    &trans  &trans  &trans  &trans    &msc SCRL_RIGHT  &msc SCRL_DOWN  &mkp MB4        &mkp MB5        &to_layer_0 PERIOD  &to_layer_0 SLASH  &lt SCROLL BACKSLASH
&trans              &trans                          &trans          &trans          &trans          &trans                                               &trans           &trans                                                                                 &trans
            >;
        };

        function_scroll {
            display-name = "FUNC";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &kp F1            &kp F2          &kp F3          &kp F4                &kp F5                                   &trans  &trans  &trans  &trans                  &kp F6                  &kp F7                   &kp F8            &kp F9           &kp F10        &kp F11
&trans  &kp F11           &kp F12         &kp UP_ARROW    &trans                &trans                                   &trans  &trans  &trans  &trans                  &kp LG(LS(LEFT_ARROW))  &kp LG(LS(RIGHT_ARROW))  &kp UP_ARROW      &trans           &trans         &trans
&trans  &kp LC(UP_ARROW)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW       &trans                &trans             &trans  &trans  &trans  &trans    &bt BT_SEL 0  &kp LEFT_SHIFT          &kp LEFT_ARROW           &kp DOWN_ARROW    &kp RIGHT_ARROW  &kp SPACE      &trans
&trans  &kp LC(DOWN)      &trans          &kp LS(LG(S))   &kp LS(LA(NUMBER_4))  &kp LS(LA(NUMBER_5))  &pw                &trans  &trans  &trans  &trans    &bt BT_SEL 1  &kp RIGHT_CONTROL       &kp C_PREVIOUS           &kp C_PLAY_PAUSE  &kp C_NEXT       &kp RIGHT_ALT  &trans
&trans  &trans                            &kp ENTER       &kp C_MUTE            &kp C_VOLUME_DOWN     &kp C_VOLUME_UP                                      &trans        &bt BT_SEL 1                                                                                       &kp DEL
            >;
        };

        symbol_layer {
            display-name = "SYMBOL";
            sensor-bindings = <&inc_dec_kp LA(F2) LA(F1)>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp SLASH                      &trans  &trans  &trans  &trans                     &trans       &trans          &trans                &trans                 &trans            &trans
&trans  &trans        &kp N7        &kp N8        &kp NUMBER_9  &kp ASTERISK                   &trans  &trans  &trans  &trans                     &kp AT_SIGN  &kp GRAVE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES
&trans  &trans        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS     &trans           &trans  &trans  &trans  &trans    &msc SCRL_LEFT   &kp EQUAL    &kp PLUS        &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SEMICOLON     &kp COLON
&trans  &trans        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PLUS      &trans           &trans  &trans  &trans  &trans    &msc SCRL_RIGHT  &kp MINUS    &kp UNDERSCORE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans            &trans
&trans  &trans                      &kp N0        &kp DOT       &kp ENTER     &kp BACKSPACE                                      &bt BT_SEL 0     &trans                                                                                      &bt BT_PRV
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none                   &trans  &trans  &trans  &trans              &bt BT_CLR      &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &none  &none  &none  &none
&trans  &kp C_MUTE                  &trans        &trans        &trans        &trans                                      &trans    &kp DEL                                     &trans
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
